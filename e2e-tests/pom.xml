<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>sh.oso</groupId>
    <artifactId>kafka-connect-oracle-cdc-parent</artifactId>
    <version>0.1.4-SNAPSHOT</version>
  </parent>

  <artifactId>e2e-tests</artifactId>
  <name>e2e-tests</name>
  <description>Testcontainers suites against Oracle Database Free and a real Kafka Connect worker, the CORE-REF spikes, the regression corpus and the documentation generators. Never published.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipPublishing>true</skipPublishing>
    <gpg.skip>true</gpg.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <maven.source.skip>true</maven.source.skip>
    <!-- Docker 25+ rejects the docker-java default API version -->
    <docker.api.version>1.44</docker.api.version>
    <oracle.image.tag>23.26.3-slim-faststart</oracle.image.tag>
    <e2e.groups/>
    <!-- DebeziumCutoverConnectorIT (PRD-04): the Debezium Oracle connector (Apache-2.0) from Maven
         Central, unpacked from its own plugin archive (its runtime jars and the Oracle JDBC driver it
         ships, no Kafka or Connect jars) into a plugin directory the Connect worker mounts next to
         ours. Never on the test classpath. -->
    <debezium.version>3.7.0.Final</debezium.version>
    <debezium.plugin.root>${project.build.directory}/debezium-plugin</debezium.plugin.root>
    <!-- AvroConverterConnectorIT (ADR-0020): Apicurio Registry (Apache-2.0) in memory, and its Avro
         converter with the Avro serde's runtime jars from Maven Central, staged as a plugin directory
         the Connect worker mounts next to ours (pre-integration-test). The image tag follows the
         converter version. -->
    <apicurio.registry.image>quay.io/apicurio/apicurio-registry:${apicurio.version}</apicurio.registry.image>
    <apicurio.converter.dir>${project.build.directory}/apicurio-converter</apicurio.converter.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>sh.oso</groupId>
      <artifactId>oracle-cdc-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>sh.oso</groupId>
      <artifactId>oracle-cdc-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>sh.oso</groupId>
      <artifactId>kafka-connect-oracle-cdc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>sh.oso</groupId>
      <artifactId>oracle-cdc-doctor</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>sh.oso</groupId>
      <artifactId>bench</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>connect-api</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>connect-json</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- the Avro converter and its Avro serde (AvroConverterConnectorIT): the suite reads records
         with AvroKafkaDeserializer, and the apicurio-converter execution below stages the same jars
         for the worker. The JSON Schema and Protobuf serdes are left out; nothing here uses them. -->
    <dependency>
      <groupId>io.apicurio</groupId>
      <artifactId>apicurio-registry-utils-converter</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>io.apicurio</groupId>
          <artifactId>apicurio-registry-jsonschema-serde-kafka</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.apicurio</groupId>
          <artifactId>apicurio-registry-protobuf-serde-kafka</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- used directly by the suite (GenericRecord, Schema); declared here so that Avro's own
           commons-compress, which needs 1.26 or later, wins over the older one Testcontainers asks
           for, on the test classpath and in the staged converter directory -->
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>oracle-free</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>toxiproxy</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>debezium-plugin</id>
            <goals>
              <goal>unpack</goal>
            </goals>
            <phase>pre-integration-test</phase>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.debezium</groupId>
                  <artifactId>debezium-connector-oracle</artifactId>
                  <version>${debezium.version}</version>
                  <classifier>plugin</classifier>
                  <type>tar.gz</type>
                  <outputDirectory>${debezium.plugin.root}</outputDirectory>
                </artifactItem>
              </artifactItems>
              <overWriteReleases>false</overWriteReleases>
            </configuration>
          </execution>
          <execution>
            <!-- AvroConverterConnectorIT: the Apicurio Avro converter and the runtime jars of its Avro
                 serde, as resolved for this module's tests (one version of each), copied flat into a
                 plugin directory. Kafka, the compression codecs and SLF4J stay out: the worker
                 provides them. A group the converter needs and this list lacks shows up as a
                 NoClassDefFoundError in the worker log, never as a silent pass. Every jar's licence
                 is on the allowlist of the root POM. -->
            <id>apicurio-converter</id>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <phase>pre-integration-test</phase>
            <configuration>
              <outputDirectory>${apicurio.converter.dir}</outputDirectory>
              <includeGroupIds>io.apicurio,org.apache.avro,com.fasterxml.jackson.core,org.apache.commons,commons-codec,commons-io,com.microsoft.kiota,io.kiota,io.github.std-uritemplate,io.opentelemetry,io.vertx,io.netty,jakarta.annotation,jakarta.ws.rs,jakarta.validation,org.projectnessie.cel,com.dashjoin</includeGroupIds>
              <overWriteReleases>false</overWriteReleases>
              <overWriteSnapshots>false</overWriteSnapshots>
              <overWriteIfNewer>true</overWriteIfNewer>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <project.version>${project.version}</project.version>
            <repo.root>${project.basedir}/..</repo.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!-- Tiers are selected by class-name suffix through the e2e-* profiles below
               (-De2e.groups=engine|connector|nightly selects *EngineIT, *ConnectorIT, *NightlyIT). The surefire
               <groups> tag filter and directory-based include patterns both made the forked JVM run nothing. -->
          <systemPropertyVariables>
            <project.version>${project.version}</project.version>
            <repo.root>${project.basedir}/..</repo.root>
            <api.version>${docker.api.version}</api.version>
            <oracle.image.tag>${oracle.image.tag}</oracle.image.tag>
            <debezium.version>${debezium.version}</debezium.version>
            <debezium.plugin.dir>${debezium.plugin.root}/debezium-connector-oracle</debezium.plugin.dir>
            <apicurio.registry.image>${apicurio.registry.image}</apicurio.registry.image>
            <apicurio.converter.dir>${apicurio.converter.dir}</apicurio.converter.dir>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Skip Docker e2e with -DskipE2E (environments without Docker) -->
      <id>skip-e2e</id>
      <activation>
        <property>
          <name>skipE2E</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <skipITs>true</skipITs>
            </configuration>
          </plugin>
          <plugin>
            <!-- no Debezium download when no integration test runs -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>debezium-plugin</id>
                <configuration>
                  <skip>true</skip>
                </configuration>
              </execution>
              <execution>
                <id>apicurio-converter</id>
                <configuration>
                  <skip>true</skip>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- T1 engine: Oracle Database Free only -->
      <id>e2e-engine</id>
      <activation>
        <property>
          <name>e2e.groups</name>
          <value>engine</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <!-- the forked JVM re-filters test classes and accepts only the plain suffix form -->
                <include>**/*EngineIT.java</include>
              </includes>
              <failIfNoTests>true</failIfNoTests>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- T4 qualification: the container by default, an external database with -De2e.external.url
           (Amazon RDS in the temporary dev-account lab); the same suites run on both -->
      <id>e2e-qual</id>
      <activation>
        <property>
          <name>e2e.groups</name>
          <value>qual</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <!-- the forked JVM re-filters test classes and accepts only the plain suffix form -->
                <include>**/*QualIT.java</include>
              </includes>
              <failIfNoTests>true</failIfNoTests>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- T1 connector: Oracle plus Kafka plus a real Connect worker -->
      <id>e2e-connector</id>
      <activation>
        <property>
          <name>e2e.groups</name>
          <value>connector</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <!-- the forked JVM re-filters test classes and accepts only the plain suffix form -->
                <include>**/*ConnectorIT.java</include>
              </includes>
              <failIfNoTests>true</failIfNoTests>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- T2 nightly: fault injection and long runs -->
      <id>e2e-nightly</id>
      <activation>
        <property>
          <name>e2e.groups</name>
          <value>nightly</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <!-- the forked JVM re-filters test classes and accepts only the plain suffix form -->
                <include>**/*NightlyIT.java</include>
              </includes>
              <failIfNoTests>true</failIfNoTests>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
