{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "maven",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "kafka-connect-oracle-cdc",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {"type": "pom", "path": "oracle-cdc-core/pom.xml"},
        {"type": "pom", "path": "kafka-connect-oracle-cdc/pom.xml"},
        {"type": "pom", "path": "oracle-cdc-doctor/pom.xml"},
        {"type": "pom", "path": "bench/pom.xml"},
        {"type": "pom", "path": "e2e-tests/pom.xml"}
      ]
    }
  }
}
