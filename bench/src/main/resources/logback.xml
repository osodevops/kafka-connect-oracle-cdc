<!-- Console logging of the bench CLI (workload, check, soak). Kafka and JDBC clients log at WARN so a
     long soak's console carries the soak's own lines; logback-test.xml in a test classpath wins. -->
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSX,UTC} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="org.apache.kafka" level="WARN"/>
  <root level="INFO">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
