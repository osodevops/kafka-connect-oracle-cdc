{
  "title": "OSO CDC Connector for Oracle Database",
  "uid": "oso-cdc-oracle-connector",
  "tags": [
    "kafka-connect",
    "cdc"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "server",
        "type": "query",
        "label": "Server (topic prefix)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(oracle_cdc_steps_total, server)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "SCN lag (database SCN minus mined-to SCN)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oracle_cdc_scn_lag{server=~\"$server\"}",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Time behind source at last commit",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oracle_cdc_millis_behind_source{server=~\"$server\"}",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rows mined per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(oracle_cdc_rows_mined_total{server=~\"$server\"}[5m])",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Transactions committed per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(oracle_cdc_transactions_committed_total{server=~\"$server\"}[5m])",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Open transactions",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oracle_cdc_open_transactions{server=~\"$server\"}",
          "legendFormat": "{{server}}"
        },
        {
          "refId": "B",
          "expr": "oracle_cdc_journaled_transactions{server=~\"$server\"}",
          "legendFormat": "{{server}}"
        },
        {
          "refId": "C",
          "expr": "oracle_cdc_spilled_transactions{server=~\"$server\"}",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Buffer heap use",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oracle_cdc_buffer_heap_bytes{server=~\"$server\"} / oracle_cdc_buffer_memory_max_bytes{server=~\"$server\"}",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Spill use",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oracle_cdc_spilled_bytes{server=~\"$server\"} / oracle_cdc_spill_max_bytes{server=~\"$server\"}",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Last step duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oracle_cdc_last_step_millis{server=~\"$server\"}",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Step retries, timeouts and reconnects",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(oracle_cdc_step_retries_total{server=~\"$server\"}[15m])",
          "legendFormat": "{{server}}"
        },
        {
          "refId": "B",
          "expr": "increase(oracle_cdc_step_timeouts_total{server=~\"$server\"}[15m])",
          "legendFormat": "{{server}}"
        },
        {
          "refId": "C",
          "expr": "increase(oracle_cdc_reconnects_total{server=~\"$server\"}[15m])",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "DLQ records and decode failures",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(oracle_cdc_dlq_records_total{server=~\"$server\"}[15m])",
          "legendFormat": "{{server}}"
        },
        {
          "refId": "B",
          "expr": "increase(oracle_cdc_decode_failures_total{server=~\"$server\"}[15m])",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Records waiting for Connect",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oracle_cdc_queue_depth{server=~\"$server\"}",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Journal chunks and LOB rows",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(oracle_cdc_journal_chunks_total{server=~\"$server\"}[5m])",
          "legendFormat": "{{server}}"
        },
        {
          "refId": "B",
          "expr": "rate(oracle_cdc_lob_rows_applied_total{server=~\"$server\"}[5m])",
          "legendFormat": "{{server}}"
        }
      ]
    }
  ]
}
