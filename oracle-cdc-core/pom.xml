<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>sh.oso</groupId>
    <artifactId>kafka-connect-oracle-cdc-parent</artifactId>
    <version>0.1.2-SNAPSHOT</version>
  </parent>

  <artifactId>oracle-cdc-core</artifactId>
  <name>oracle-cdc-core</name>
  <description>Oracle Database LogMiner capture engine: connections, log inventory, mining, decoding, transaction buffer, position model and schema registry. Independent of Kafka Connect.</description>

  <dependencies>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
    </dependency>
    <dependency>
      <!-- ConfigDef only; the Connect runtime provides it -->
      <groupId>org.apache.kafka</groupId>
      <artifactId>connect-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- 80 per cent line coverage gate on the engine; testkit is test support and excluded -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <excludes>
                <exclude>sh/oso/connect/oracle/core/testkit/**</exclude>
                <!-- JDBC-bound classes are covered by the Oracle suites in e2e-tests, not by unit tests -->
                <exclude>sh/oso/connect/oracle/core/topology/JdbcCatalogSource*</exclude>
                <exclude>sh/oso/connect/oracle/core/logs/LogSetProbe*</exclude>
                <exclude>sh/oso/connect/oracle/core/doctor/Jdbc*</exclude>
                <exclude>sh/oso/connect/oracle/core/mining/JdbcLogMinerSession*</exclude>
                <exclude>sh/oso/connect/oracle/core/mining/JdbcObjectCatalog*</exclude>
                <exclude>sh/oso/connect/oracle/core/schema/JdbcDictionaryReader*</exclude>
                <exclude>sh/oso/connect/oracle/core/engine/JdbcLobReselector*</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- testkit (FakeLogMiner, FaultyJdbc, FakeCatalog) is shared with the connector and e2e modules -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
