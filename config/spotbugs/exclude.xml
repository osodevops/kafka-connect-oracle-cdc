<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Records and constructor-injected collaborators: collections are copied with List.copyOf in compact
       constructors and connections are owned by the caller by design. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- CT_CONSTRUCTOR_THROW fires on every constructor that validates its arguments; the "finalizer
       attack" it guards against needs a subclass with a finalizer, which this codebase never writes. -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
  <!-- picocli populates @Option fields reflectively -->
  <Match>
    <Bug pattern="UWF_UNWRITTEN_FIELD,UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD,URF_UNREAD_FIELD,NP_UNWRITTEN_FIELD"/>
    <Or>
      <Class name="~sh\.oso\.connect\.oracle\.doctor\.cli\..*"/>
      <Class name="~sh\.oso\.connect\.oracle\.bench\..*Main.*"/>
    </Or>
  </Match>
  <!-- CLI entry points print to stdout and stderr by design -->
  <Match>
    <Bug pattern="DM_DEFAULT_ENCODING"/>
    <Or>
      <Class name="~sh\.oso\.connect\.oracle\.doctor\.cli\..*"/>
      <Class name="~sh\.oso\.connect\.oracle\.bench\..*"/>
    </Or>
  </Match>
  <!-- the workload generator, doctor catalog, LOB reselect and snapshot reader build statements from quoted identifiers by design, and the dictionary reader's read at start a list of bind placeholders; values are bound -->
  <Match>
    <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING,SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
    <Or>
      <Class name="~sh\.oso\.connect\.oracle\.bench\.workload\..*"/>
      <Class name="~sh\.oso\.connect\.oracle\.core\.schema\.JdbcDictionaryReader"/>
      <Class name="~sh\.oso\.connect\.oracle\.core\.doctor\.JdbcDoctorCatalog"/>
      <Class name="~sh\.oso\.connect\.oracle\.core\.engine\.JdbcLobReselector"/>
      <Class name="~sh\.oso\.connect\.oracle\.core\.snapshot\.JdbcSnapshotSource"/>
    </Or>
  </Match>
  <!-- test support code -->
  <Match>
    <Class name="~sh\.oso\.connect\.oracle\.core\.testkit\..*"/>
  </Match>
</FindBugsFilter>
