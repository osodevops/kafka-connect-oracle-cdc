{
  "name": "orders-cdc",
  "config": {
    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "1",
    "database.hostname": "db.prod.internal",
    "database.port": "1521",
    "database.user": "c##dbzuser",
    "database.password": "${file:/opt/kafka/secrets/oracle.properties:password}",
    "database.dbname": "ORCLCDB",
    "database.pdb.name": "ORCLPDB1",
    "topic.prefix": "orders",
    "table.include.list": "APP.ORDERS,APP.ORDER_LINES",
    "schema.history.internal.kafka.topic": "orders.schema-history",
    "schema.history.internal.kafka.bootstrap.servers": "kafka-1:9092,kafka-2:9092",
    "include.schema.changes": "false",
    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "key.converter.schema.registry.url": "http://schema-registry:8081",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081"
  }
}
