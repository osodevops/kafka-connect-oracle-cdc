{
  "name": "inventory-connector-oso",
  "config": {
    "name": "inventory-connector-oso",
    "connector.class": "sh.oso.connect.oracle.OracleCdcSourceConnector",
    "tasks.max": "1",
    "cdc.archive.destination": "LOG_ARCHIVE_DEST_1",
    "cdc.capture.mode": "online",
    "cdc.database.host": "oracle.example.com",
    "cdc.database.password": "********",
    "cdc.database.pdbs": "ORCLPDB1",
    "cdc.database.port": "1521",
    "cdc.database.service": "ORCLCDB",
    "cdc.database.url": "jdbc:oracle:thin:@//oracle.example.com:1521/ORCLCDB",
    "cdc.database.user": "c##dbzuser",
    "cdc.decimal.mode": "precise",
    "cdc.heartbeat.interval.ms": "10000",
    "cdc.kafka.bootstrap.servers": "kafka:9092",
    "cdc.key.missing": "none",
    "cdc.lob.mode": "inline",
    "cdc.on.decode.error": "dlq",
    "cdc.output.format": "debezium",
    "cdc.snapshot.mode": "none",
    "cdc.snapshot.threads": "2",
    "cdc.start.scn": "324567890",
    "cdc.tables.exclude": "ORCLPDB1\\.INVENTORY\\.ORDERS_ARCHIVE,ORCLPDB1\\.INVENTORY_TMP\\..+",
    "cdc.tables.include": "ORCLPDB1\\.(?=(?:INVENTORY|SALES)\\.)INVENTORY\\.CUSTOMERS,ORCLPDB1\\.(?=(?:INVENTORY|SALES)\\.)INVENTORY\\.ORDERS,ORCLPDB1\\.(?=(?:INVENTORY|SALES)\\.)SALES\\.INVOICES",
    "cdc.temporal.mode": "adaptive",
    "cdc.tombstones.on.delete": "true",
    "cdc.topic.prefix": "server1",
    "cdc.topic.template": "${prefix}.${schema}.${table}",
    "cdc.transaction.max.age.action": "discard",
    "cdc.transaction.max.age.ms": "3600000",
    "cdc.unavailable.placeholder": "__debezium_unavailable_value",
    "cdc.users.exclude": "GGADMIN",
    "exactly.once.support": "required",
    "transaction.boundary": "connector"
  }
}
