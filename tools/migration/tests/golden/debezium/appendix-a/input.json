{
  "name": "inventory-connector",
  "config": {
    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "1",
    "database.hostname": "oracle.example.com",
    "database.port": "1521",
    "database.user": "c##dbzuser",
    "database.password": "dbz-literal-password",
    "database.url": "jdbc:oracle:thin:@//oracle.example.com:1521/ORCLCDB",
    "database.dbname": "ORCLCDB",
    "database.pdb.name": "ORCLPDB1",
    "database.connection.adapter": "logminer",
    "topic.prefix": "server1",
    "table.include.list": "INVENTORY\\.CUSTOMERS,INVENTORY\\.ORDERS,ORCLPDB1\\.SALES\\.INVOICES",
    "table.exclude.list": "INVENTORY\\.ORDERS_ARCHIVE",
    "schema.include.list": "INVENTORY,SALES",
    "schema.exclude.list": "INVENTORY_TMP",
    "column.exclude.list": "INVENTORY\\.CUSTOMERS\\.SSN",
    "log.mining.username.exclude.list": "GGADMIN",
    "log.mining.username.include.list": "APPUSER",
    "snapshot.mode": "initial",
    "snapshot.max.threads": "2",
    "log.mining.strategy": "online_catalog",
    "log.mining.batch.size.min": "1000",
    "log.mining.batch.size.max": "100000",
    "log.mining.batch.size.default": "20000",
    "log.mining.sleep.time.min.ms": "0",
    "log.mining.sleep.time.max.ms": "3000",
    "log.mining.sleep.time.default.ms": "1000",
    "log.mining.sleep.time.increment.ms": "200",
    "log.mining.query.filter.mode": "in",
    "log.mining.buffer.type": "memory",
    "log.mining.buffer.drop.on.stop": "false",
    "log.mining.transaction.retention.ms": "3600000",
    "log.mining.archive.log.only.mode": "false",
    "log.mining.archive.destination.name": "LOG_ARCHIVE_DEST_1",
    "archive.destination.name": "LOG_ARCHIVE_DEST_1",
    "lob.enabled": "true",
    "unavailable.value.placeholder": "__debezium_unavailable_value",
    "decimal.handling.mode": "precise",
    "time.precision.mode": "adaptive",
    "binary.handling.mode": "bytes",
    "tombstones.on.delete": "true",
    "heartbeat.interval.ms": "10000",
    "heartbeat.action.query": "INSERT INTO c##dbzuser.heartbeat VALUES (sysdate)",
    "schema.history.internal.kafka.topic": "schema-changes.inventory",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "signal.data.collection": "ORCLPDB1.C##DBZUSER.DEBEZIUM_SIGNAL",
    "rac.nodes": "",
    "event.processing.failure.handling.mode": "warn"
  }
}
