{
  "name": "kitchen-sink",
  "config": {
    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "3",
    "database.hostname": "db",
    "database.port": "1521",
    "database.user": "c##dbzuser",
    "database.password": "${vault:secret/data/oracle:password}",
    "database.dbname": "ORCLCDB",
    "database.pdb.name": "ORCLPDB1",
    "topic.prefix": "sink",
    "topic.delimiter": "_",
    "table.include.list": "APP\\.ORDERS",
    "time.precision.mode": "connect",
    "binary.handling.mode": "hex",
    "interval.handling.mode": "string",
    "skipped.operations": "none",
    "provide.transaction.metadata": "true",
    "message.key.columns": "APP.ORDERS:ORDER_ID,REGION;APP\\.ORDER_LINES:LINE_ID",
    "column.mask.with.12.chars": "APP.CUSTOMERS.EMAIL",
    "driver.oracle.net.ssl_server_dn_match": "true",
    "driver.javax.net.ssl.trustStore": "/etc/ssl/truststore.jks",
    "driver.javax.net.ssl.trustStoreType": "PKCS12",
    "driver.oracle.net.wallet_location": "(SOURCE=(METHOD=file)(METHOD_DATA=(DIRECTORY=/opt/wallet)))",
    "transforms": "unwrap",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "errors.tolerance": "all",
    "errors.max.retries": "5",
    "snapshot.select.statement.overrides": "APP.ORDERS",
    "snapshot.select.statement.overrides.APP.ORDERS": "SELECT * FROM APP.ORDERS WHERE STATUS <> 'X'",
    "post.processors": "reselector",
    "converters": "boolean",
    "boolean.type": "io.debezium.connector.oracle.converters.NumberOneToBooleanConverter",
    "log.mining.flush.table.name": "LOG_MINING_FLUSH",
    "max.batch.size": "4096",
    "max.queue.size": "16384",
    "poll.interval.ms": "500",
    "custom.metric.tags": "env=prod",
    "unknown.vendor.setting": "x"
  }
}
