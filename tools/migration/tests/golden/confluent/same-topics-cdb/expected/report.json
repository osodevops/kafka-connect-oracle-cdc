  "exactly_once": {
    "status": "not checked",
    "detail": "no --connect-url given"
  },
  "follow_ups": [
    {
      "text": "Keep the existing topics and consumers. Check the documented differences: exact Decimal scales (rounding stops CDC-3001), additional cdc.* headers, SQL suppression with column exclusions, LOB key moves, and optional OSO truncate records.",
      "properties": []
    },
    {
      "text": "Separate LOB topics require stable column keys, complete values and sufficient undo for AS OF commit reselect. OSO moves LOB state on key changes; Confluent 2.15.2 did not.",
      "properties": [
        "lob.topic.name.template"
      ]
    },
    {
      "text": "OSO refuses NUMBER values needing rounding to fit numeric.default.scale, including snapshots (CDC-3001); Confluent snapshots rounded HALF_EVEN. Increase the scale before cutover when needed.",
      "properties": [
        "numeric.default.scale"
      ]
    },
    {
      "text": "The redo log topic (`redo.log.topic.name`, default `${connectorName}-${databaseName}-redo-log`) stops receiving data at the cutover (MIG-5). Move or retire its consumers, then delete it after the agreed retention.",
      "properties": []
    },
    {
      "text": "If the worker uses Avro or Protobuf, configure cdc.journal.converter and cdc.journal.converter.* to match before enabling cdc.kafka.bootstrap.servers.",
      "properties": []
    },
    {
      "text": "Exactly-once delivery was not configured because the target Connect cluster was not checked (no --connect-url given). Run the translator again with `--connect-url`, or add `exactly.once.support=required` and `transaction.boundary=connector` yourself once the workers run with `exactly.once.source.support=enabled`.",
      "properties": []
    }
  ],
