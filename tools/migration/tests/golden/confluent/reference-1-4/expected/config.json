{
  "name": "confluent-oracle-cdc-oso",
  "config": {
    "name": "confluent-oracle-cdc-oso",
    "connector.class": "sh.oso.connect.oracle.OracleCdcSourceConnector",
    "tasks.max": "1",
    "cdc.database.host": "oracle.example.com",
    "cdc.database.password": "${file:/opt/secrets/oracle.properties:password}",
    "cdc.database.pdbs": "ORCLPDB1",
    "cdc.database.port": "1521",
    "cdc.database.service": "ORCLCDB",
    "cdc.database.sid": "ORCLCDB",
    "cdc.database.user": "C##MYUSER",
    "cdc.decimal.mode": "precise",
    "cdc.lob.mode": "skip",
    "cdc.log.sensitive.data": "false",
    "cdc.mining.fetch.size": "1000",
    "cdc.mining.query.timeout.ms": "300000",
    "cdc.on.decode.error": "fail",
    "cdc.output.format": "debezium",
    "cdc.poll.linger.ms": "5000",
    "cdc.poll.max.records": "1000",
    "cdc.retry.max.time.ms": "86400000",
    "cdc.snapshot.fetch.size": "2000",
    "cdc.snapshot.mode": "none",
    "cdc.snapshot.threads": "4",
    "cdc.tables.case.sensitive": "true",
    "cdc.tables.exclude": "ORCLPDB1[.]C##MYUSER[.]ORDERS_TMP",
    "cdc.tables.include": "ORCLPDB1[.]C##MYUSER[.](ORDERS|CUSTOMERS)",
    "cdc.tombstones.on.delete": "false",
    "cdc.topic.prefix": "confluent-oracle-cdc",
    "cdc.topic.template": "${pdb}.${schema}.${table}",
    "cdc.users.exclude": "GGADMIN",
    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter"
  }
}
