{
  "name": "confluent-oracle-cdc",
  "config": {
    "connector.class": "io.confluent.connect.oracle.cdc.OracleCdcSourceConnector",
    "tasks.max": "8",
    "oracle.server": "oracle.example.com",
    "oracle.port": "1521",
    "oracle.username": "C##MYUSER",
    "oracle.password": "${file:/opt/secrets/oracle.properties:password}",
    "oracle.sid": "ORCLCDB",
    "oracle.pdb.name": "ORCLPDB1",
    "oracle.service.name": "ORCLCDB",
    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "table.inclusion.regex": "ORCLPDB1[.]C##MYUSER[.](ORDERS|CUSTOMERS)",
    "table.exclusion.regex": "ORCLPDB1[.]C##MYUSER[.]ORDERS_TMP",
    "table.topic.name.template": "${databaseName}.${schemaName}.${tableName}",
    "redo.log.topic.name": "${connectorName}-${databaseName}-redo-log",
    "redo.log.consumer.bootstrap.servers": "kafka:9092",
    "redo.log.consumer.fetch.min.bytes": "1",
    "redo.log.consumer.max.partition.fetch.bytes": "1048576",
    "redo.log.consumer.fetch.max.bytes": "52428800",
    "redo.log.consumer.max.poll.records": "500",
    "redo.log.consumer.request.timeout.ms": "30000",
    "redo.log.consumer.receive.buffer.bytes": "65536",
    "redo.log.consumer.send.buffer.bytes": "131072",
    "start.from": "snapshot",
    "key.template": "${primaryKeyStructOrValue}",
    "max.batch.size": "1000",
    "query.timeout.ms": "300000",
    "max.retry.time.ms": "86400000",
    "redo.log.poll.interval.ms": "1000",
    "snapshot.row.fetch.size": "2000",
    "redo.log.row.fetch.size": "1000",
    "poll.linger.ms": "5000",
    "snapshot.threads.per.task": "4",
    "heartbeat.interval.ms": "0",
    "heartbeat.topic.name": "${connectorName}-${databaseName}-heartbeat-topic",
    "use.transaction.begin.for.mining.session": "true",
    "log.mining.transaction.age.threshold.ms": "-1",
    "log.mining.transaction.threshold.breached.action": "warn",
    "redo.log.corruption.topic": "",
    "behavior.on.dictionary.mismatch": "fail",
    "behavior.on.unparsable.statement": "fail",
    "oracle.dictionary.mode": "auto",
    "log.mining.archive.destination.name": "",
    "record.buffer.mode": "connector",
    "max.batch.timeout.ms": "60000",
    "max.buffer.size": "0",
    "lob.topic.name.template": "",
    "enable.large.lob.object.support": "false",
    "log.sensitive.data": "false",
    "numeric.mapping": "none",
    "numeric.default.scale": "127",
    "oracle.date.mapping": "date",
    "emit.tombstone.on.delete": "false",
    "oracle.fan.events.enable": "false",
    "table.task.reconfig.checking.interval.ms": "300000",
    "table.rps.logging.interval.ms": "60000",
    "log.mining.end.scn.deviation.ms": "0",
    "output.before.state.field": "",
    "output.table.name.field": "table",
    "output.scn.field": "scn",
    "output.commit.scn.field": "",
    "output.op.type.field": "op_type",
    "output.op.ts.field": "op_ts",
    "output.current.ts.field": "current_ts",
    "output.row.id.field": "row_id",
    "output.username.field": "username",
    "output.redo.field": "",
    "output.undo.field": "",
    "output.op.type.read.value": "R",
    "output.op.type.insert.value": "I",
    "output.op.type.update.value": "U",
    "output.op.type.delete.value": "D",
    "output.op.type.truncate.value": "T",
    "redo.log.startup.polling.limit.ms": "300000",
    "snapshot.by.table.partitions": "false",
    "oracle.validation.result.fetch.size": "5000",
    "redo.log.row.poll.fields.include": "",
    "redo.log.row.poll.fields.exclude": "",
    "redo.log.row.poll.username.include": "",
    "redo.log.row.poll.username.exclude": "GGADMIN",
    "db.timezone": "UTC",
    "db.timezone.date": "UTC",
    "oracle.supplemental.log.level": "full",
    "ldap.url": "",
    "ldap.security.principal": "",
    "ldap.security.credentials": "",
    "oracle.ssl.truststore.file": "",
    "oracle.ssl.truststore.password": "",
    "oracle.kerberos.cache.file": "",
    "retry.error.codes": "",
    "enable.metrics.collection": "false",
    "confluent.license": "",
    "confluent.topic.bootstrap.servers": "kafka:9092",
    "confluent.topic.replication.factor": "3",
    "connection.pool.initial.size": "0",
    "connection.pool.min.size": "0",
    "connection.pool.max.size": "1",
    "redo.log.initial.delay.interval.ms": "0"
  }
}
